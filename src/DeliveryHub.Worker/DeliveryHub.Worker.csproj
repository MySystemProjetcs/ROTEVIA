<!-- SDK Web, não Worker: o processo precisa expor o health do polling. Sem isso
     a métrica fica só na memória e ninguém descobre que o heartbeat parou —
     e heartbeat parado significa todas as lojas offline no iFood. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4e11dcc4-b91a-4386-9720-c050cb4e939a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeliveryHub.Infrastructure\DeliveryHub.Infrastructure.csproj" />
    <ProjectReference Include="..\DeliveryHub.Application\DeliveryHub.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" Version="8.8.0" />
  </ItemGroup>
</Project>
