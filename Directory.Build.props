<Project>
  <PropertyGroup>
    <!--
      MessagePack 2.5.187 (dependência indireta via SignalR MessagePack Protocol)
      lista 10 CVEs; a cadeia pode ser atualizada aos poucos, mas por ora os
      NU1902/NU1903 ficam como warning e param de quebrar o `dotnet ef` e
      ferramentas que elevam warning do audit a erro. Monitorar: subir pra
      MessagePack 3.x é breaking change que o SignalR ainda não acompanha
      totalmente — ao atualizar a dependência, remova este bloco.
    -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
</Project>
